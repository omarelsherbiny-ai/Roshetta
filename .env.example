# ==========================================
# Roshetta (روشتة) Environment Configuration
# ==========================================

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# Generate a unique random secret (at least 32 characters) for each deployment.
SERVER_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
# Default: local SQLite for fast zero-friction testing; or PostgreSQL url
DATABASE_URL=sqlite+aiosqlite:///./roshetta.db
# Demo accounts use publicly documented PINs; keep disabled outside isolated demos.
SEED_DEMO_DATA=false
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/roshetta

# Optional MicroMind text integration; only general-chat question text is sent.
# Structured pharmacy actions and data queries run locally. OCR is not implemented.
MICROMIND_API_URL=https://core.aimicromind.com/api/v1/prediction/6637553c-7474-47e2-b288-4c26da5df4e9
USE_MICROMIND=true

# Fallback LLM Providers (if needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# OCR & Vision Provider
OCR_PROVIDER=disabled

# Storage (local disk is currently the only implemented driver)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

PENDING_ACTION_TTL_HOURS=24
TRUSTED_PROXY_IPS=127.0.0.1